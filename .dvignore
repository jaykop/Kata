# dv-ignore-version: 1

# Git 내부 데이터는 Diversion에 동기화하지 않는다.
.git/

# Unreal 생성 파일은 프로젝트와 플러그인 모두에서 제외한다.
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# IDE 생성 파일과 개인 설정을 제외한다.
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.code-workspace
*.DotSettings.user

# 임시 파일을 제외한다.
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# 인증 정보와 로컬 에이전트 설정을 제외한다.
.mcp.json
.env
.env.*
!.env.example
*.pem
*.key
.claude/*
# 플러그인 지정과 공유 프로필만 추적한다. 개인 프로필(profile.local.md)과 나머지 로컬 설정은 제외한다.
!.claude/settings.json
!.claude/workflow/
.claude/workflow/*
!.claude/workflow/profile.md
!.claude/ko-review/
.claude/ko-review/*
!.claude/ko-review/profile.md
!.claude/ko-review/terms.json
.codex/
.agents/
auth.json
credentials.json

# 빌드 전에 생성하는 Native GameplayTag 소스를 제외한다.
/Source/ProjectKata/KataTags.h
/Source/ProjectKata/KataTags.cpp

# HKX 변환 도구는 공개 저장소(Git)에서만 제외하고 Diversion에서는 추적한다.
# .gitignore의 제외를 여기서 다시 포함한 뒤 Python 캐시만 제외한다.
!/Scripts/HkxConverter/
!/Scripts/HkxConverter/**
__pycache__/
*.pyc

# 로컬 문서(작업 인계 기록·초안·변환 도구 문서)는 공개 저장소(Git)에서만 제외하고 Diversion에서 추적한다.
!/docs/localdocs/
!/docs/localdocs/**

# Git에서 제외한 프로젝트 에셋은 Diversion에서 추적한다.
!/Content/
!/Content/**

# 개발자별 개인 콘텐츠는 Content 재포함 규칙보다 뒤에서 제외한다.
/Content/Developers/

# 설명 검토 목록의 임시 쓰기 파일과 작업 잠금은 동기화하지 않는다.
/docs/localdocs/threads/*.descriptions.json.lock
/docs/localdocs/threads/*.descriptions.json.*.tmp
