# dv-ignore-version: 1

# Git 내부 데이터는 Diversion에 동기화하지 않는다.
.git/

# Unreal 생성 파일은 프로젝트와 플러그인 모두에서 제외한다.
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# IDE 생성 파일과 개인 설정을 제외한다.
.vs/
.idea/
.vscode/
*.sln
*.slnx
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.code-workspace
*.DotSettings.user

# 임시 파일을 제외한다.
*.log
*.tmp
*.bak
.DS_Store
Thumbs.db

# 인증 정보와 로컬 에이전트 설정을 제외한다.
.mcp.json
.env
.env.*
!.env.example
*.pem
*.key
.claude/
.codex/
.agents/
auth.json
credentials.json

# 빌드 전에 생성하는 Native GameplayTag 소스를 제외한다.
/Source/ProjectKata/KataTags.h
/Source/ProjectKata/KataTags.cpp

# HKX 변환 도구는 공개 저장소(Git)에서만 제외하고 Diversion에서는 추적한다.
# .gitignore의 제외를 여기서 다시 포함한 뒤 Python 캐시만 제외한다.
!/Scripts/HkxConverter/
!/Scripts/HkxConverter/**
__pycache__/
*.pyc

# 로컬 문서는 제외하되, 변환 도구 사용법과 변환 결과 목록은 도구와 함께 Diversion에서 추적한다.
# 하위 폴더(threads·archive·issue-drafts·reference·images)의 세션 메모와 초안은 계속 제외한다.
!/docs/localdocs/
/docs/localdocs/*
!/docs/localdocs/Hkx-Converter.md
!/docs/localdocs/2026-09-30-Hkx-Converter.md
!/docs/localdocs/DS3-Characters.md
!/docs/localdocs/DS3-Characters-Animations.csv
!/docs/localdocs/SilverKnight-Animations.md
!/docs/localdocs/SilverKnight-Animation-Index.csv

# Git에서 제외한 프로젝트 에셋은 Diversion에서 추적한다.
!/Content/
!/Content/**

# 개발자별 개인 콘텐츠는 Content 재포함 규칙보다 뒤에서 제외한다.
/Content/Developers/
