* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
# Markdown uses trailing spaces for intentional hard line breaks.
*.md text eol=lf whitespace=-blank-at-eol
*.h text eol=lf
*.cpp text eol=lf
*.cs text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.uproject text eol=lf
*.uplugin text eol=lf
*.ps1 text eol=lf

# Unreal binary assets use Git LFS when content is added.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
